{
  "name": "@idds/styles",
  "version": "1.6.38",
  "description": "Shared CSS styles and colors for INA Digital Design System",
  "type": "module",
  "main": "./dist/index.css",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.min.css",
    "./index": "./dist/index.css",
    "./index.min": "./dist/index.min.css",
    "./base": "./dist/base.css",
    "./base.min": "./dist/base.min.css",
    "./assets/*": "./dist/assets/*",
    "./tailwind/ts/*": {
      "import": "./dist/tailwind/ts/*.js",
      "require": "./dist/tailwind/ts/*.js",
      "types": "./dist/tailwind/ts/*.d.ts"
    },
    "./tailwind/css/idds.css": "./dist/tailwind/css/idds.css",
    "./tailwind/css/idds.min.css": "./dist/tailwind/css/idds.min.css",
    "./tailwind/css/panrb.css": "./dist/tailwind/css/panrb.css",
    "./tailwind/css/panrb.min.css": "./dist/tailwind/css/panrb.min.css",
    "./tailwind/css/inagov.css": "./dist/tailwind/css/inagov.css",
    "./tailwind/css/inagov.min.css": "./dist/tailwind/css/inagov.min.css",
    "./tailwind/css/inaku.css": "./dist/tailwind/css/inaku.css",
    "./tailwind/css/inaku.min.css": "./dist/tailwind/css/inaku.min.css",
    "./tailwind/css/inapas.css": "./dist/tailwind/css/inapas.css",
    "./tailwind/css/inapas.min.css": "./dist/tailwind/css/inapas.min.css",
    "./tailwind/css/bgn.css": "./dist/tailwind/css/bgn.css",
    "./tailwind/css/bgn.min.css": "./dist/tailwind/css/bgn.min.css",
    "./tailwind/css/bkn.css": "./dist/tailwind/css/bkn.css",
    "./tailwind/css/bkn.min.css": "./dist/tailwind/css/bkn.min.css",
    "./tailwind/css/lan.css": "./dist/tailwind/css/lan.css",
    "./tailwind/css/lan.min.css": "./dist/tailwind/css/lan.min.css"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:watch": "node scripts/build.js --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm version patch && npm publish"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "css",
    "styles",
    "design-system",
    "ina-digital",
    "ui",
    "components"
  ],
  "author": "INA Digital",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inadigital/designsystem-advanced.git",
    "directory": "idds/packages/styles"
  },
  "bugs": {
    "url": "https://github.com/inadigital/designsystem-advanced/issues"
  },
  "homepage": "https://github.com/inadigital/designsystem-advanced#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "typescript": "^5.3.3"
  }
}
